# 复制本文件为 config.env，再填入真实值。config.env 不要发给任何人（已在 .gitignore 里，不会上传）。
# 云端运行时不用这个文件，改由 GitHub 仓库的 Secrets 提供同名变量。

# 飞书开放平台 → 应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 知识库表格链接 https://<企业域名>.feishu.cn/wiki/<WIKI_TOKEN>?sheet=<SHEET_ID>
WIKI_TOKEN=
SHEET_ID=

# 卡片上「打开完整驾驶舱」按钮的默认地址（本机运行且隧道未就绪时使用）
DASHBOARD_URL=

# 测试用：填了就读这个本地 Excel，而不是知识库表格；正式使用时清空
LOCAL_XLSX=
